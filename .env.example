# Copy to `.env` and adjust. All variables use the APIV3_ prefix.

# --- Admin UI (static page at /ui; public like /docs, data access needs a key) ---
APIV3_UI_ENABLED=true

# --- Authentication (two roles, sent via the X-API-Key header) ---
# ADMIN key    -> the critical/expensive endpoints: /train, /train/stop and all
#                 dataset/model management (import, export, delete, analyze).
# READONLY key -> classification + status only (/predict*, /train/status, listings).
# Set AUTH_ENABLED=false for purely local use (grants full access without a key;
# Swagger /docs and the admin UI /ui then work without signing in).
APIV3_AUTH_ENABLED=true
APIV3_API_KEY_ADMIN=change-me-admin-key
APIV3_API_KEY_READONLY=change-me-readonly-key

# --- CORS (comma-separated origin allowlist; empty = no cross-origin access) ---
APIV3_CORS_ALLOW_ORIGINS=

# --- Compute resources ---
# CPU cores for per-label head training. -1 = all cores (joblib semantics; -2 =
# all but one). The value is additionally bounded by CPU_MAX_PERCENT below.
APIV3_N_JOBS=-1
# Hard CPU budget for a training run, in percent of the machine's cores: the
# effective thread count is min(N_JOBS, cores*percent/100). Default 60 keeps the
# API and desktop responsive while training. Set 100 to disable the cap.
APIV3_CPU_MAX_PERCENT=60
# Note: BLAS thread oversubscription is capped in code (OMP/OPENBLAS/MKL_NUM_THREADS=1,
# set before numpy loads); override by exporting those as real OS environment vars.
# Solver + joblib backend. 'newton-cg' (default) and 'saga' keep the float32
# matrix (RAM-safe) and release the GIL, so 'threading' trains all labels on ONE
# shared matrix (all cores, ~1x RAM, fits large data on small machines).
# newton-cg converges fast; saga is slow on high-dim TF-IDF. 'lbfgs'/'liblinear'
# upcast to float64 (2x RAM); pair the GIL-bound 'liblinear' with backend 'loky'.
APIV3_SOLVER=newton-cg
APIV3_PARALLEL_BACKEND=threading
# TF-IDF vocabulary caps = RAM/quality lever (profiles in config.yaml can override).
APIV3_TFIDF_MAX_WORD_FEATURES=80000
APIV3_TFIDF_MAX_CHAR_FEATURES=120000

# --- Logging ---
APIV3_LOG_LEVEL=INFO

# --- Storage paths (defaults: ./data, ./models, ./share_links.json) ---
# Point these at a mounted volume in containerized deployments — the provided
# docker-compose.yml / Helm chart set them to /data/* automatically.
#APIV3_DATA_DIR=
#APIV3_MODELS_DIR=
#APIV3_SHARE_LINKS_FILE=
# Training profiles file (default: ./config.yaml next to the app).
#APIV3_CONFIG_FILE=

# --- RAM / limits ---
# How many trained models stay resident in memory (LRU eviction beyond this).
APIV3_MAX_MODELS_IN_MEMORY=2
APIV3_MAX_UPLOAD_MB=200
# Comma-separated model names to preload + warm on startup, so their first
# /predict pays no cold skops-load. Empty = off. Keep the count <= the LRU size
# above, or only the last that-many stay resident.
APIV3_WARMUP_MODELS=

# --- Rate limiting (per client IP; see README for the reverse-proxy note) ---
APIV3_RATE_LIMIT_ENABLED=true
#APIV3_RATE_LIMIT_PREDICT=300/minute
#APIV3_RATE_LIMIT_TRAIN=5/minute
#APIV3_RATE_LIMIT_EXPORT=30/minute
#APIV3_RATE_LIMIT_DEFAULT=120/minute

# --- Reproducibility ---
#APIV3_RANDOM_SEED=42

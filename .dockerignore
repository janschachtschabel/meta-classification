# Keep the build context small: the Dockerfile only COPYs app/, config.yaml
# and requirements* — everything else is dead weight (data/ + models/ alone
# are several hundred MB) or does not belong in an image.
data/
models/
# Exported bundles staged for hand-off: 57 MB of a 64 MB context, uploaded to the
# daemon on every build and reaching no layer. `.gitignore` already excluded it —
# tests/test_deployment_config.py now keeps the two files from disagreeing again.
fertige-modelle/
cache/
tests/
deploy/
.github/
.git/
.env
share_links.json
# dockerignore patterns are NOT recursive like .gitignore — without `**/` the
# nested app/__pycache__ dirs ship into locally built images via `COPY app/`.
**/__pycache__
**/*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
